    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "d3": "7.9.2",
    "drizzle-orm": "0.45.4",
    "html-to-image": "1.11.13",
    "katex": "0.19.1",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "openai": "7.47.0",
    "pdf-lib": "1.17.1",
    "postgres": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
