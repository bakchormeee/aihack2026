# Copy to .env.local and fill in. Never commit real values.

# Postgres (Neon)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
# Only when running a production build on localhost (Vercel sets this itself)
# AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed for email magic-link sign-in
AUTH_RESEND_KEY=
# Local development and tests only. NEVER set on Vercel.
ENABLE_TEST_SIGN_IN=

# AI providers (src/lib/ai/README.md, "Routes"). Keys are read on the server only.
# Default provider for every call: openai (default) or anthropic.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Only needed when some call is routed to anthropic.
ANTHROPIC_API_KEY=
# Strong tier: parseSheet, extractSolutions, markAttempt, matchWorking, generateHints,
# generateVariant, writeFlawedSolution (and any other call). Cheap tier: summariseSheet,
# judgeSpotAnswer, groupMisconceptions. Empty = the provider's default
# (openai: gpt-6.2-sol / gpt-6-luna; anthropic: claude-sonnet-5-5 / claude-haiku-5-5).
AI_MODEL_STRONG=
AI_MODEL_CHEAP=
# low | medium | high | xhigh | max. Empty = medium (strong), low (cheap).
AI_EFFORT_STRONG=
AI_EFFORT_CHEAP=
# Override one call: AI_ROUTE_<callName>=provider:model[:effort], for example
# AI_ROUTE_markAttempt=anthropic:claude-sonnet-5-5:medium
# Set to 1 to return recorded responses from tests/fixtures/ai instead of calling the API
AI_FIXTURES=

# S3-compatible object storage (Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ElevenLabs speech-to-text (students can speak their spot-the-error explanations).
# Leave empty to hide the microphone button.
ELEVENLABS_API_KEY=
# Optional: Scribe model (default scribe_v2) and a fixed language such as "en"
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_STT_LANGUAGE=en
