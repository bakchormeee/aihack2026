# Copy to .env.local and fill in. Never commit real values.

# Postgres (Neon)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed for email magic-link sign-in
AUTH_RESEND_KEY=
# Local development and tests only. NEVER set on Vercel.
ENABLE_TEST_SIGN_IN=

# Claude API
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Set to 1 to return recorded responses from tests/fixtures/ai instead of calling the API
AI_FIXTURES=

# S3-compatible object storage (Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
